    {
      "id": 6,
      "type": "stat",
      "title": "DNS time",
      "description": "How long the Pi-hole takes to answer",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "transparent": true,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "monitor_response_time{monitor_type=\"dns\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#89b4fa",
                "value": null
              },
              {
                "color": "#fab387",
                "value": 100
              },
              {
                "color": "#f38ba8",
                "value": 500
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "text": {
          "valueSize": 44,
          "titleSize": 14
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "type": "state-timeline",
      "title": "Service status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "monitor_status",
          "legendFormat": "{{monitor_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 55,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "#f38ba8",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "#94e2d5",
                  "index": 1
                },
                "2": {
                  "text": "PENDING",
                  "color": "#f9e2af",
                  "index": 2
                },
                "3": {
                  "text": "MAINT",
                  "color": "#89b4fa",
                  "index": 3
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#f38ba8",
                "value": null
              },
              {
                "color": "#94e2d5",
                "value": 1
              },
              {
                "color": "#f9e2af",
                "value": 2
              },
              {
                "color": "#89b4fa",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.7,
        "alignValue": "center",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
