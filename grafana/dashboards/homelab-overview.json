{
  "uid": "homelab-overview",
  "title": "Homelab Overview",
  "tags": [
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Service status from Uptime Kuma, and host load from node exporters. Source: the homelab-monitoring repo.",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Mobile view",
      "type": "link",
      "url": "/d/homelab-mobile",
      "icon": "dashboard",
      "targetBlank": false,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "tooltip": ""
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "transparent": true,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(count(monitor_status{monitor_name!~\"(?i) *down tester *\"} == 0) or vector(0)) * 10 + (count(monitor_status{monitor_name!~\"(?i) *down tester *\"} == 2 or monitor_status{monitor_name!~\"(?i) *down tester *\"} == 3) or vector(0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#cba6f7",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0.5,
                "result": {
                  "text": "ALL SYSTEMS UP",
                  "color": "#cba6f7",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.5,
                "to": 9.5,
                "result": {
                  "text": "DEGRADED",
                  "color": "#f9e2af",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 9.5,
                "to": 1000000,
                "result": {
                  "text": "OUTAGE",
                  "color": "#f38ba8",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "text": {
          "valueSize": 30
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
